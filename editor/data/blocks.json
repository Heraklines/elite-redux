  {
   "id": "AttackTypeImmunityAbAttr",
   "label": "Be immune to one type of attack",
   "summary": "Immune to GROUND moves",
   "when": "calc.move-immunity",
   "kind": "calc-modifier",
   "tier": "A",
   "status": "verified",
   "package": false,
   "synonyms": [
    "immunity",
    "levitate",
    "ground immune",
    "no damage from a type",
    "type immunity",
    "float"
   ],
   "examples": [
    "Immune to Ground moves",
    "Immune to Dark moves"
   ],
   "params": [
    {
     "id": "type",
     "label": "Immune to this type",
     "control": "select",
     "editable": true,
     "default": "GROUND",
     "options": [
      "NORMAL",
      "FIGHTING",
      "FLYING",
      "POISON",
      "GROUND",
      "ROCK",
      "BUG",
      "GHOST",
      "STEEL",
      "FIRE",
      "WATER",
      "GRASS",
      "ELECTRIC",
      "PSYCHIC",
      "ICE",
      "DRAGON",
      "DARK",
      "FAIRY",
      "STELLAR"
     ]
    }
   ],
   "guards": [],
   "feasibility": [
    "Status moves and moves that treat Flying types neutrally (Thousand Arrows) are never blocked",
    "Moves that hit every Pokemon or a whole side (Spikes, Rain Dance) are never blocked",
    "A Pokemon never blocks its own move"
   ],
   "effect": {
    "id": "effect.immune-to-type",
    "params": [
     "type"
    ]
   },
   "reusableAlone": {
    "when": true,
    "if": true,
    "do": true
   }
  },
