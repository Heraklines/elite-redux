   "id": "PostSummonCopyAbilityAbAttr",
   "label": "Copy a foe's ability when I enter",
   "summary": "When I enter the battle, I copy an adjacent foe's ability",
   "when": "event.on-entry",
   "kind": "package",
   "tier": "C",
   "status": "verified",
   "package": true,
   "synonyms": [
    "trace",
    "copy ability",
    "mimic ability",
    "borrow ability",
    "steal ability on entry"
   ],
   "examples": [
    "Copy the opposing Pokemon's ability when I enter"
   ],
   "params": [],
   "guards": [],
   "feasibility": [
    "There must be an adjacent foe whose ability can be copied (not Trace itself, Wonder Guard or form-related abilities)"
   ],
   "effect": {
    "id": "effect.package",
    "params": []
   },
   "reusableAlone": {
    "when": true,
    "if": true,
    "do": true
   },
   "reason": "Package, justified: the attr keeps `target` and `targetAbilityName` between canApply, apply and getTriggerMessage, and its apply replaces the holder's ability (setTempAbility) and suppresses the source for two turns. Splitting would re-implement the class. Users: Trace only. Honest bucket: package-only."
  },
