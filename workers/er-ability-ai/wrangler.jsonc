{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "er-ability-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "https://er-editor.pages.dev,http://localhost:4176,http://127.0.0.1:4176,http://localhost:4174,http://127.0.0.1:4174",
    "CODEX_MODEL": "gpt-5.6-luna",
    "CODEX_EFFORT": "high",
    "NVIDIA_NIM_MODEL": "qwen/qwen3-coder-480b-a35b-instruct"
  },
  "services": [
    {
      "binding": "EDITOR_API",
      "service": "er-editor-api"
    }
  ],
  "containers": [
    {
      "class_name": "AbilityAiContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic",
      "constraints": {
        "regions": ["WEUR"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ABILITY_AI",
        "class_name": "AbilityAiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AbilityAiContainer"]
    }
  ]
}
